<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-dialog-title">
  <div class="search-dialog-inner">
    <div class="search-dialog-head">
      <h2 id="search-dialog-title" class="search-dialog-title">Pretraga</h2>
      <button type="button" class="search-close" data-search-close aria-label="Zatvori pretragu"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
    <form class="search-form" role="search" data-search-form>
      <label for="search-input" class="visually-hidden">Pretražite sajt</label>
      <i class="bi bi-search search-form-icon" aria-hidden="true"></i>
      <input type="search" id="search-input" class="search-input" placeholder="Pretražite vodiče i savete…" autocomplete="off" data-search-input>
    </form>
    <p class="search-status" role="status" aria-live="polite" data-search-status></p>
    <ul class="search-results list-unstyled" data-search-results></ul>
  </div>
</dialog>
