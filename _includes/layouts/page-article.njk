{% extends "layouts/base.njk" %}

{% set bodyClass = "article-page" %}

{% block content %}
  <div class="page-title light-background">
    <div class="container">
      <nav class="breadcrumbs">
        <ol>
          <li><a href="{{ '/' | url }}">Početna</a></li>
          <li class="current">{{ breadcrumb or pageTitle or title }}</li>
        </ol>
      </nav>
    </div>
  </div>

  <section id="blog-details" class="blog-details section">
    <div class="container">
      <article class="article">

        <div class="article-header">
          <h1 class="title">{{ title }}</h1>

          {% if author or date or readTime %}
            <div class="article-meta">
              {% if author %}
                <div class="author">
                  {% if author.photo %}<img src="{{ author.photo | url }}" alt="{{ author.name }}" class="author-img">{% endif %}
                  <div class="author-info">
                    <h4>{{ author.name }}</h4>
                    {% if author.role %}<span>{{ author.role }}</span>{% endif %}
                  </div>
                </div>
              {% endif %}
              <div class="post-info">
                {% if date %}<span><i class="bi bi-calendar4-week"></i> {{ date | dateSr }}</span>{% endif %}
                {% if readTime %}<span><i class="bi bi-clock"></i> {{ readTime }}</span>{% endif %}
              </div>
            </div>
          {% endif %}
        </div>

        {% if heroImage %}
          <div class="article-featured-image">
            <img src="{{ heroImage | url }}" alt="{{ title }}" class="img-fluid">
          </div>
        {% endif %}

        {% set groupTree = pageGroups[group] if group else null %}
        {% set autoToc = content | extractToc %}
        {% set tocItems = toc or autoToc %}

        {% set articleBody %}
          {{ content | safe }}

          {% if groupTree %}
            {% set groupHit = groupTree | groupNode(page.url) %}
            {% if groupHit.node and groupHit.node.children %}
              <nav class="guide-map group-children" aria-label="Nastavite čitanje">
                <ol>
                  {% for child in groupHit.node.children %}
                    <li class="guide-map-item">
                      <a href="{{ child.url | url }}">
                        <span class="guide-map-title">{{ child.title }}</span>
                      </a>
                    </li>
                  {% endfor %}
                </ol>
              </nav>
            {% elif groupHit.parent %}
              <p class="group-back">
                <a href="{{ groupHit.parent.url | url }}"><i class="bi bi-arrow-left"></i> Nazad na: {{ groupHit.parent.label }}</a>
              </p>
            {% endif %}
          {% endif %}

          {% if cta %}
            <aside class="article-cta">
              <div class="cta-icon"><i class="bi bi-chat-heart"></i></div>
              <div class="cta-body">
                <h3>Potrebna vam je dodatna podrška?</h3>
                <p>Naš tim stručnjaka — psihologa i pedagoga — pomaže roditeljima da pronađu najbolji odgovor na izazove sa kojima se njihova deca suočavaju u školi. Zakažite individualno savetovanje i razgovarajte sa nekim ko razume šta vam je potrebno.</p>
                <a href="{{ '/savetovanje/' | url }}" class="cta-button">Zakaži savetovanje <i class="bi bi-arrow-right"></i></a>
              </div>
            </aside>
          {% endif %}
        {% endset %}

        {% if groupTree or (tocItems and tocItems.length > 0) %}
          <div class="row">
            <div class="col-lg-3">
              {% if groupTree %}
                <aside class="table-of-contents group-toc">
                  <h3>Sadržaj</h3>
                  <nav aria-label="Sadržaj celine">
                    <ul>
                      {% for item in groupTree | groupFlatten(page.url) %}
                        <li class="depth-{{ item.depth }}{% if item.isCurrent %} is-current{% endif %}">
                          {% if item.isCurrent %}
                            <span aria-current="page"><i class="bi bi-arrow-right here-icon" aria-hidden="true" title="Nalazite se ovde"></i><span>{{ item.label }}</span><span class="visually-hidden"> (nalazite se ovde)</span></span>
                          {% else %}
                            <a href="{{ item.url | url }}">{{ item.label }}</a>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  </nav>
                </aside>
              {% else %}
                <aside class="table-of-contents">
                  <h3>Sadržaj</h3>
                  <nav>
                    <ul>
                      {% for item in tocItems %}
                        <li><a href="#{{ item.id }}">{{ item.label }}</a></li>
                      {% endfor %}
                    </ul>
                  </nav>
                </aside>
              {% endif %}
            </div>
            <div class="col-lg-9">
              <div class="article-content">
                {{ articleBody | safe }}
              </div>
            </div>
          </div>
        {% else %}
          <div class="article-content">
            {{ articleBody | safe }}
          </div>
        {% endif %}

        <div class="article-footer">
          <div class="share-article">
            <h4>Podelite članak</h4>
            <div class="share-buttons">
              <a href="#" class="share-button twitter"><i class="bi bi-twitter-x"></i><span>Podeli na X</span></a>
              <a href="#" class="share-button facebook"><i class="bi bi-facebook"></i><span>Podeli na Facebook-u</span></a>
              <a href="#" class="share-button linkedin"><i class="bi bi-linkedin"></i><span>Podeli na LinkedIn-u</span></a>
            </div>
          </div>
        </div>

      </article>
    </div>
  </section>
{% endblock %}
